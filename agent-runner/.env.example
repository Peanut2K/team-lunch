# ---- server ----
PORT=8787
# URL สาธารณะของ tunnel (ngrok / cloudflared) ไม่มี / ท้าย
PUBLIC_URL=https://your-name.ngrok-free.app

# repo หลัก (clone ไว้แล้ว) และโฟลเดอร์ที่ใช้สร้าง worktree แยกให้แต่ละ agent
REPO_DIR=C:\Users\USER\Desktop\team-lunch
WORK_DIR=C:\Users\USER\Desktop\team-lunch-agents

# ---- Claude Code ----
CLAUDE_BIN=claude
# รันแบบไม่มีคนนั่งกดอนุญาต: bypassPermissions (ทำงานใน worktree แยกเท่านั้น) หรือ auto
CLAUDE_PERMISSION_MODE=bypassPermissions
JOB_TIMEOUT_MIN=45

# ---- Linear apps (1 app ต่อ 1 agent) ----
BE_DEV_CLIENT_ID=
BE_DEV_CLIENT_SECRET=
BE_DEV_WEBHOOK_SECRET=

FE_DEV_CLIENT_ID=
FE_DEV_CLIENT_SECRET=
FE_DEV_WEBHOOK_SECRET=

QA_CLIENT_ID=
QA_CLIENT_SECRET=
QA_WEBHOOK_SECRET=
